# ==============================================================================
# AgentPay Demo Configuration
# ==============================================================================

# 1. Agent Identification & Wallet Configuration
# Agent Key generated in the AgentPay Gateway (starts with apk_live_ or apk_test_)
AGENT_KEY=apk_live_209aaf0b44c4fbd955457368ab63a2a745ceea0ccd107ad2

# Agent Local Signer Private Key (Zero-Trust Local Key)
# Default test key from Anvil (DO NOT USE IN PRODUCTION WITH REAL FUNDS)
AGENT_PRIVATE_KEY=0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d

# 2. Network & Asset (CAIP-2 format)
# Arbitrum Sepolia: eip155:421614 | Base Sepolia: eip155:84532 | Local Anvil: eip155:31337
PAYMENT_NETWORK=eip155:421614
PAYMENT_ASSET=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
PAYMENT_ASSET_SYMBOL=USDC

# 3. Seller Gateway Configuration
SELLER_WALLET=0x1111111111111111111111111111111111111111
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_URL=http://127.0.0.1:8000/gateway

# 4. Financial Firewall Defaults (Amount in base units: 1 USDC = 1_000_000)
# Max per transaction: 10_000 ($0.01 USDC)
MAX_PER_TX_BASE_UNITS=10000
# 24h rolling budget: 100_000 ($0.10 USDC)
ROLLING_BUDGET_24H_BASE_UNITS=100000
# Circuit breaker: max requests per minute
CIRCUIT_MAX_RPM=20

# 5. LLM Provider (Optional: if not set, Built-in Mock LLM is used automatically)
LLM_PROVIDER=mock
# Options: mock | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
